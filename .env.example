# Application
APP_NAME=travel-assistant
ENVIRONMENT=development
APP_DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# OpenAI-compatible LLM service (required when the Agent is implemented in P2)
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.example.com/v1
DEFAULT_LLM_MODEL=replace-me

# Observability (optional in local development)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-assistant

# MySQL system-management database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=assistant
MYSQL_USER=mysql
MYSQL_PASSWORD=123456
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_ECHO=false

# Planned cache infrastructure
REDIS_URL=
