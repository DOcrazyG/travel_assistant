# Application
TRAVEL_ASSISTANT_APP_NAME=travel-assistant
TRAVEL_ASSISTANT_ENVIRONMENT=development
TRAVEL_ASSISTANT_DEBUG=true
TRAVEL_ASSISTANT_LOG_LEVEL=INFO
TRAVEL_ASSISTANT_HOST=127.0.0.1
TRAVEL_ASSISTANT_PORT=8000

# OpenAI-compatible LLM service (required when the Agent is implemented in P2)
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.example.com/v1
DEFAULT_LLM_MODEL=replace-me

# Observability (optional in local development)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-assistant

# Planned P1 infrastructure; leave unset until PostgreSQL/Redis are configured.
DATABASE_URL=
REDIS_URL=
