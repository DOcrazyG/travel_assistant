# Application
APP_NAME=travel-assistant
ENVIRONMENT=development
APP_DEBUG=true
LOG_LEVEL=INFO
# console is convenient locally; use json in staging and production.
LOG_FORMAT=console
HOST=127.0.0.1
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI-compatible LLM service (required when the Agent is implemented in P2)
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.example.com/v1
DEFAULT_LLM_MODEL=replace-me

# Observability (optional in local development)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-assistant

# Local-account authentication. Replace both development values with high-entropy
# secrets before staging or production; production also requires a configured CORS allowlist.
JWT_SECRET_KEY=development-only-secret-change-before-production
JWT_ISSUER=travel-assistant
JWT_AUDIENCE=travel-assistant-api
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_DAYS=30
MAX_ACTIVE_AUTH_SESSIONS=5
REFRESH_COOKIE_NAME=travel_assistant_refresh
REFRESH_COOKIE_SECURE=false
PII_HASH_KEY=development-only-pii-hash-key-change-before-production

# Initial administrator. Generate a password with secrets.token_urlsafe(32).
# The application creates this account only when no non-deleted administrator exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL system-management and LangGraph checkpoint database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=travel_assistant
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_ECHO=false

# Valkey (Redis-compatible) rate limiting and short-lived state
REDIS_URL=redis://127.0.0.1:6379/0
VALKEY_USERNAME=default
VALKEY_PASSWORD=replace-with-output-from-secrets-token-urlsafe-32
ALLOW_IN_MEMORY_RATE_LIMIT=true
